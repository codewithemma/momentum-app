NODE_ENV=development

# Required: base URL of the compatible Momentum API.
NEXT_PUBLIC_API_URL=https://api.example.com
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Required: OAuth client created for the Google Web application.
AUTH_GOOGLE_ID=your-google-client-id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your-google-client-secret

# Required: strong random secret used by Auth.js to protect JWT sessions.
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/callback/google

